# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# The harness reads this file at start-up (evalkit/config/loader.py).

# Required for any run that calls a model (agents or judges). Use a key with a spending limit.
ANTHROPIC_API_KEY=

# Optional: override configs/eval.yaml without editing it
# EVALKIT_RUNS_DIR=C:/Users/<you>/.evalkit-runs     # keep run output outside Dropbox
# EVALKIT_MAX_WORKERS=4                             # parallel trials (rate-limit control)
