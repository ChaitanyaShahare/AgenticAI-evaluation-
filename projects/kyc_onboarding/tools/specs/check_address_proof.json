{
  "name": "check_address_proof",
  "description": "Check an address-proof document against the address on the application, on the test clock: passports past expiry and utility bills older than 2 months are EXPIRED.",
  "x-agent": "identity",
  "x-tool-class": "read",
  "x-fault-modes": [
    "empty result"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "doc_id": {
        "type": "string",
        "pattern": "^DOC-[0-9A-Za-z]+(-[A-Z0-9]+)+$"
      },
      "address": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "required": [
      "doc_id",
      "address"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "EXPIRED",
              "NOT_ADDRESS_PROOF"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        },
        "description": "Business or validation error"
      }
    ]
  }
}
