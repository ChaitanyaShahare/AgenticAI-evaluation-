{
  "name": "request_customer_info",
  "description": "Ask the customer for missing or corrected information and return their reply (scripted in tests). A null reply means the customer did not respond.",
  "x-agent": "supervisor",
  "x-tool-class": "interaction",
  "x-fault-modes": [],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fields": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "minItems": 1,
        "maxItems": 10
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "required": [
      "fields",
      "reason"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ANSWERED",
              "NO_RESPONSE"
            ]
          },
          "customer_reply": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "customer_reply"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        },
        "description": "Business or validation error"
      }
    ]
  }
}
