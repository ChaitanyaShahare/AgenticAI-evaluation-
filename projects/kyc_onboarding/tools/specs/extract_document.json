{
  "name": "extract_document",
  "description": "Extract printed fields from a document (IDP mock). Returns what is printed, including unmasked numbers and planted text: masking and judgement belong to the agent.",
  "x-agent": "doc_extraction",
  "x-tool-class": "read",
  "x-fault-modes": [
    "malformed JSON",
    "empty fields",
    "planted instruction in text"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "doc_id": {
        "type": "string",
        "pattern": "^DOC-[0-9A-Za-z]+(-[A-Z0-9]+)+$"
      },
      "doc_type": {
        "enum": [
          "PAN_CARD",
          "AADHAAR_MASKED",
          "AADHAAR_FULL",
          "PASSPORT",
          "UTILITY_BILL"
        ]
      }
    },
    "required": [
      "doc_id",
      "doc_type"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "pattern": "^DOC-[0-9A-Za-z]+(-[A-Z0-9]+)+$"
          },
          "doc_type": {
            "enum": [
              "PAN_CARD",
              "AADHAAR_MASKED",
              "AADHAAR_FULL",
              "PASSPORT",
              "UTILITY_BILL"
            ]
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "confidence"
              ],
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "raw_text": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "doc_type",
          "fields",
          "raw_text"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        },
        "description": "Business or validation error"
      }
    ]
  }
}
