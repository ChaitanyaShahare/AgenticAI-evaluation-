{
  "name": "sanctions_screen",
  "description": "Screen a name, date of birth and nationality against the sanctions lists. Returns every candidate scoring ≥ 0.70; hit ≥ 0.85 and near-match 0.75–0.849 are the agent's thresholds.",
  "x-agent": "screening",
  "x-tool-class": "read",
  "x-fault-modes": [
    "timeout then success",
    "HTTP 500"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "full_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "dob": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "ISO date YYYY-MM-DD"
      },
      "nationality": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "required": [
      "full_name",
      "dob",
      "nationality"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "screening_ref": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entry_id",
                "score",
                "matched_fields"
              ],
              "properties": {
                "entry_id": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "matched_fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "list": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "remark": {
                  "type": "string"
                }
              }
            }
          },
          "lists_version": {
            "type": "string"
          }
        },
        "required": [
          "screening_ref",
          "candidates",
          "lists_version"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        },
        "description": "Business or validation error"
      }
    ]
  }
}
