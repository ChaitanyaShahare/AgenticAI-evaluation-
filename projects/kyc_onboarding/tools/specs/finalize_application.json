{
  "name": "finalize_application",
  "description": "Set the application's final status and reason codes (the end state graded by TR-1).",
  "x-agent": "supervisor",
  "x-tool-class": "write",
  "x-fault-modes": [],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "application_id": {
        "type": "string",
        "pattern": "^APL-[0-9A-Za-z]+$"
      },
      "status": {
        "enum": [
          "APPROVED",
          "PENDING_INFO",
          "PENDING_EDD",
          "REJECTED"
        ]
      },
      "reason_codes": {
        "type": "array",
        "items": {
          "enum": [
            "SCREENING_HIT",
            "PEP_HIT",
            "HIGH_RISK",
            "DOC_MISSING",
            "DOC_LOW_QUALITY",
            "DOC_EXPIRED",
            "NAME_INCONSISTENT",
            "ID_MISMATCH",
            "PAN_INVALID",
            "OUT_OF_SCOPE_CUSTOMER_TYPE",
            "SYS_UNAVAILABLE",
            "APPROVER_DENIED",
            "APPROVAL_TIMEOUT",
            "INFO_MISSING",
            "RECORD_CREATION_FAILED"
          ]
        },
        "uniqueItems": true,
        "description": "Reason codes from decision table D1–D10"
      }
    },
    "required": [
      "application_id",
      "status",
      "reason_codes"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "APPROVED",
              "PENDING_INFO",
              "PENDING_EDD",
              "REJECTED"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        },
        "description": "Business or validation error"
      }
    ]
  }
}
