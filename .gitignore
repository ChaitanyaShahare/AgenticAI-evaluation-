# .gitignore for bfsi-agent-eval (public repository).
# A pattern here only stops *untracked* files. A file that is already committed stays in the repository until it is
# removed from the index:  git rm --cached <path>   (the file stays on your disk).

# ---------------------------------------------------------------- secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
credentials*.json
secrets.*
*.secret

# ---------------------------------------------------------------- run output (regenerated by every run)
# runs/<run_id>/ holds trajectories, per-trial databases, reports, cost.json; the judge cache and the monthly cost
# ledger also live here. Point EVALKIT_RUNS_DIR outside the repository to keep it empty.
runs/*
!runs/.gitkeep
*.trial.sqlite
projects/kyc_onboarding/data/*.new.sqlite
judge_cache/
cost_ledger.jsonl
*.log
logs/

# ---------------------------------------------------------------- Python, uv, test and lint caches
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.python-env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.ipynb_checkpoints/
.deepeval/

# ---------------------------------------------------------------- editors and IDEs
.vscode/*
!.vscode/extensions.json
*.code-workspace
.history/
.idea/
*.iml
*.swp
*.swo
*~

# Claude Code: personal settings stay local (shared project settings, if any, may be committed)
.claude/settings.local.json
.claude/*.local.*

# ---------------------------------------------------------------- operating system and sync clients
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.dropbox
.dropbox.attr
.dropbox.cache/

# ---------------------------------------------------------------- Office lock and temporary files
~$*
*.tmp
*.bak
*.orig

# ---------------------------------------------------------------- restricted training material
# The bug-hunt lab answer key must not be readable by the testers it assesses. Keep it outside the public repository.
training/lab/answer_key/

# ---------------------------------------------------------------- review before publishing (uncomment to exclude)
# Internal working drafts of the SOP (tracked changes, review comments, private links):
# docs/sop/*.docx
# Personal delivery plan (dates, people, budget); README and docs link to it:
# EXECUTION_PLAN.md
# Notes on how the code was generated with Claude Code:
# prompts/
